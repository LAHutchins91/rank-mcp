# Public origin of this server, with no trailing slash.
# The Google redirect URI is exactly ${APP_BASE_URL}/google/callback
APP_BASE_URL=http://127.0.0.1:44721
PORT=44721

# Google Cloud OAuth client (Web application). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts Google refresh tokens at rest and signs login cookies. Use a long random string.
TOKEN_ENCRYPTION_KEY=

# memory (local tests), file (single server), blob (Vercel), or postgres
STORAGE_BACKEND=memory
STORAGE_FILE=./data/rank-store.json
STORAGE_BLOB_PATH=rank/store.json
DATABASE_URL=

# Injected by Vercel when a Blob store is connected. Do not commit a real token.
# BLOB_READ_WRITE_TOKEN=

# Stripe price IDs, not amounts. The price is shown only at Checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
